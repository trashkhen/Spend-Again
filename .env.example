# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── AI Provider — Google Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# BOT_TOKEN is read by BOTH apps/bot (grammy) AND apps/api (Telegram hash verification).
# Do not rename to TELEGRAM_BOT_TOKEN — the API's telegram-auth.ts reads BOT_TOKEN specifically.
BOT_TOKEN=your-telegram-bot-token-here

# ── Auth ───────────────────────────────────────────────────────────────────────
# JWT_SECRET signs all user JWTs (30-day expiry). Must be a strong random secret in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# ── Bot URLs ───────────────────────────────────────────────────────────────────
# DASHBOARD_URL: URL the bot uses when generating the dashboard deep-link button.
#   Dev:  http://localhost:5173
#   Prod: https://your-app.vercel.app
DASHBOARD_URL=http://localhost:5173

# API_URL: Base URL the bot uses for all API calls.
#   Dev:  http://localhost:3001
#   Prod: https://your-api.up.railway.app
API_URL=http://localhost:3001

# ── Production-only (Railway) ──────────────────────────────────────────────────
# NODE_ENV: Set to "production" in Railway to enable webhook mode on the bot.
# NODE_ENV=production

# WEBHOOK_URL: Full public HTTPS URL the bot's webhook server is reachable at.
# Railway auto-provides this once deployed — set it to the bot service's public URL.
# WEBHOOK_URL=https://your-bot.up.railway.app

# CORS_ORIGINS: Comma-separated list of allowed dashboard origins for the API.
#   Dev:  not needed (defaults to localhost:5173 and localhost:4173)
#   Prod: https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# ── Dev / testing (optional — do not set in production) ────────────────────────
# DEV_TELEGRAM_ID=your-telegram-numeric-id  # bot: auto-links you to the test user
# VITE_DEV_MODE=true                        # dashboard: shows the "Skip login" button
