# Required vs Optional is annotated per var. Required vars are hard-failed at
# startup by `requireEnv` in @spend-again/shared — missing them throws clearly.

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
# Required (api, db migrate, integration tests)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── AI Provider — Google Gemini ────────────────────────────────────────────────
# Required (bot — NLP parsing + receipt OCR)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Required. BOT_TOKEN is read by BOTH apps/bot (grammy) AND apps/api (Telegram
# hash verification). Do not rename to TELEGRAM_BOT_TOKEN — the API's
# telegram-auth.ts reads BOT_TOKEN specifically.
BOT_TOKEN=your-telegram-bot-token-here

# ── Auth ───────────────────────────────────────────────────────────────────────
# Required. JWT_SECRET signs all user JWTs (30-day expiry). Must be a strong
# random secret in production. Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# ── Bot URLs ───────────────────────────────────────────────────────────────────
# Optional. DASHBOARD_URL is used by the bot when generating dashboard
# deep-link buttons. Falls back to the public Vercel URL if unset.
#   Dev:  http://localhost:5173
#   Prod: https://your-app.vercel.app
DASHBOARD_URL=http://localhost:5173

# Required (bot). API_URL is the base URL the bot uses for all API calls.
# No default — the bot will throw at startup if missing.
#   Dev:  http://localhost:3001
#   Prod: https://your-api.up.railway.app
API_URL=http://localhost:3001

# ── Production-only (Railway) ──────────────────────────────────────────────────
# Optional. NODE_ENV: Set to "production" in Railway to enable webhook mode on
# the bot and structured-JSON logging.
# NODE_ENV=production

# Optional. WEBHOOK_URL: Full public HTTPS URL the bot's webhook server is
# reachable at. Required only when NODE_ENV=production; without it the bot
# falls back to long-polling.
# WEBHOOK_URL=https://your-bot.up.railway.app

# Optional. CORS_ORIGINS: Comma-separated list of allowed dashboard origins
# for the API.
#   Dev:  not needed (defaults to localhost:5173 and localhost:4173)
#   Prod: https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# ── Dev / testing (optional — do not set in production) ────────────────────────
# Optional. DEV_TELEGRAM_ID: bot auto-links you to the test user.
# DEV_TELEGRAM_ID=your-telegram-numeric-id
# Optional. VITE_DEV_MODE: dashboard shows the "Skip login" button.
# VITE_DEV_MODE=true

# ── Tests ──────────────────────────────────────────────────────────────────────
# Optional. Disposable Postgres URL for integration tests. NEVER point at prod.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spend_again_test
