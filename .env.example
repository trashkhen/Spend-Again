# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# AI Provider — Google Gemini (free tier)
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Auth
JWT_SECRET=your-jwt-secret-here
BOT_TOKEN=your-telegram-bot-token-here

# Dev / testing (optional — do not set in production)
# DEV_TELEGRAM_ID=your-telegram-numeric-id  # bot: auto-links you to the test user
# VITE_DEV_MODE=true                        # dashboard: shows the "Skip login" button
